# Local development defaults to a SQLite file at data/rylan-hayes.db.
# Optional: override the local file location.
# DATABASE_PATH=./data/rylan-hayes.db

# Production: point at a hosted libSQL / Turso database. When set, these take
# precedence over the local SQLite file.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Optional: public site URL used for canonical links and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://www.rylanhayes.com
